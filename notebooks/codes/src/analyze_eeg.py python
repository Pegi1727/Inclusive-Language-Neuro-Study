from pathlib import Path
import argparse
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy import signal


def read_edf_header(path: Path):
    """
    Read an EDF header according to the EDF specification.
    Returns general metadata and per-channel metadata.
    """

    with path.open("rb") as f:
        fixed_header = f.read(256)

        if len(fixed_header) != 256:
            raise ValueError("The EDF file is too small or incomplete.")

        version = fixed_header[0:8].decode("latin1").strip()
        patient_id = fixed_header[8:88].decode("latin1").strip()
        recording_id = fixed_header[88:168].decode("latin1").strip()
        start_date = fixed_header[168:176].decode("latin1").strip()
        start_time = fixed_header[176:184].decode("latin1").strip()
        header_bytes = int(fixed_header[184:192].decode("latin1").strip())
        reserved = fixed_header[192:236].decode("latin1").strip()
        number_of_records = int(fixed_header[236:244].decode("latin1").strip())
        record_duration = float(
            fixed_header[244:252].decode("latin1").strip()
        )
        number_of_signals = int(
            fixed_header[252:256].decode("latin1").strip()
        )

        ns = number_of_signals

        labels = [
            f.read(16).decode("latin1").strip()
            for _ in range(ns)
        ]

        transducers = [
            f.read(80).decode("latin1").strip()
            for _ in range(ns)
        ]

        physical_dimensions = [
            f.read(8).decode("latin1").strip()
            for _ in range(ns)
        ]

        physical_minimums = [
            float(f.read(8).decode("latin1").strip())
            for _ in range(ns)
        ]

        physical_maximums = [
            float(f.read(8).decode("latin1").strip())
            for _ in range(ns)
        ]

        digital_minimums = [
            int(float(f.read(8).decode("latin1").strip()))
            for _ in range(ns)
        ]

        digital_maximums = [
            int(float(f.read(8).decode("latin1").strip()))
            for _ in range(ns)
        ]

        prefiltering = [
            f.read(80).decode("latin1").strip()
            for _ in range(ns)
        ]

        samples_per_record = [
            int(f.read(8).decode("latin1").strip())
            for _ in range(ns)
        ]

        signal_reserved = [
            f.read(32).decode("latin1").strip()
            for _ in range(ns)
        ]

    return {
        "version": version,
        "patient_id": patient_id,
        "recording_id": recording_id,
        "start_date": start_date,
        "start_time": start_time,
        "header_bytes": header_bytes,
        "reserved": reserved,
        "number_of_records": number_of_records,
        "record_duration": record_duration,
        "number_of_signals": number_of_signals,
        "labels": labels,
        "transducers": transducers,
        "physical_dimensions": physical_dimensions,
        "physical_minimums": physical_minimums,
        "physical_maximums": physical_maximums,
        "digital_minimums": digital_minimums,
        "digital_maximums": digital_maximums,
        "prefiltering": prefiltering,
        "samples_per_record": samples_per_record,
        "signal_reserved": signal_reserved,
    }


def read_edf_data(path: Path, metadata: dict):
    """
    Read EDF signal records):
    """
    Read EDF signal records and convert digital values to physical units.
    """

    ns = metadata["number_of_signals"]
    n_records = metadata["number_of_records"]
    samples_per_record = metadata["samples_per_record"]

    physical_minimums = np.array(metadata["physical_minimums"])
    physical_maximums = np.array(metadata["physical_maximums"])
    digital_minimums = np.array(metadata["digital_minimums"])
    digital_maximums = np.array(metadata["digital_maximums"])

    channel_data = [
        [] for _ in range(ns)
    ]

    with path.open("rb") as f:
        f.seek(metadata["header_bytes"])

        for _ in range(n_records):
            for ch in range(ns):
                n_samples = samples_per_record[ch]

                raw = np.fromfile(
                    f,
                    dtype="<i2",
                    count=n_samples
                )

                if len(raw) != n_samples:
                    raise ValueError(
                        "The EDF file ends before all samples are read."
                    )

                # Digital-to-physical conversion
                physical = (
                    physical_minimums[ch]
                    + (raw - digital_minimums[ch])
                    * (
                        physical_maximums[ch]
                        - physical_minimums[ch]
                    )
                    / (
                        digital_maximums[ch]
                        - digital_minimums[ch]
                    )
                )

                channel_data[ch].append(physical)

    data = np.array([
        np.concatenate(channel_data[ch])
        for ch in range(ns)
    ])

    return data


def calculate_sampling_rates(metadata: dict):
    duration = metadata["record_duration"]

    if duration <= 0:
        raise ValueError("Record duration must be positive.")

    return np.array(metadata["samples_per_record"]) / duration


def calculate_bandpower(x, fs, low, high):
    """
    Calculate absolute band power using Welch's method.
    """

    frequencies, psd = signal.welch(
        x,
        fs=fs,
        nperseg=min(len(x), int(fs * 4))
    )

    mask = (frequencies >= low) & (frequencies <= high)

    if not np.any(mask):
        return np.nan

    return np.trapz(psd[mask], frequencies[mask])


def summarize_channels(data, labels, sampling_rates):
    rows = []

    bands = {
        "delta_power": (1, 4),
        "theta_power": (4, 8),
        "alpha_power": (8, 13),
        "beta_power": (13, 30),
        "gamma_power": (30, 45),
    }

    for idx, label in enumerate(labels):
        x = data[idx]
        fs = sampling_rates[idx]

        row = {
            "channel": label,
            "sampling_rate_hz": fs,
            "n_samples": len(x),
            "duration_seconds": len(x) / fs,
            "mean_uv": np.mean(x),
            "std_uv": np.std(x, ddof=1),
            "minimum_uv": np.min(x),
            "maximum_uv": np.max(x),
            "rms_uv": np.sqrt(np.mean(x ** 2)),
        }

        powers = {}

        for band_name, (low, high) in bands.items():
            powers[band_name] = calculate_bandpower(
                x,
                fs,
                low,
                high
            )
            row[band_name] = powers[band_name]

        total_power = np.nansum(list(powers.values()))

        if total_power > 0:
            for band_name, power in powers.items():
                relative_name = band_name.replace(
                    "_power",
                    "_relative_power"
                )
                row[relative_name] = power / total_power
        else:
            for band_name in powers:
                relative_name = band_name.replace(
                    "_power",
                    "_relative_power"
                )
                row[relative_name] = np.nan

        rows.append(row)

    return pd.DataFrame(rows)


def plot_raw_signals(data, labels, sampling_rates, output_path):
    n_channels, n_samples = data.shape

    # The current file has one sampling rate for all channels.
    fs = sampling_rates[0]
    time = np.arange(n_samples) / fs

    fig, axes = plt.subplots(
        n_channels,
        1,
        figsize=(14, 2.5 * n_channels),
        sharex=True
    )

    if n_channels == 1:
        axes = [axes]

    for idx, ax in enumerate(axes):
        ax.plot(time, data[idx], linewidth=0.6)
        ax.set_ylabel("µV")
        ax.set_title(labels[idx])
        ax.grid(alpha=0.25)

    axes[-1].set_xlabel("Time (seconds)")
    fig.suptitle("Raw EEG Signals", fontsize=16)
    fig.tight_layout()

    fig.savefig(output_path, dpi=300)
    plt.close(fig)


def plot_psd(data, labels, sampling_rates, output_path):
    n_channels = data.shape[0]

    fig, axes = plt.subplots(
        n_channels,
        1,
        figsize=(12, 2.8 * n_channels),
        sharex=True
    )

    if n_channels == 1:
        axes = [axes]

    for idx, ax in enumerate(axes):
        fs = sampling_rates[idx]

        frequencies, psd = signal.welch(
            data[idx],
            fs=fs,
            nperseg=min(len(data[idx]), int(fs * 4))
        )

        mask = frequencies <= 50

        ax.semilogy(
            frequencies[mask],
            psd[mask],
            linewidth=1
        )

        ax.set_ylabel("PSD")
        ax.set_title(labels[idx])
        ax.grid(alpha=0.25)

    axes[-1].set_xlabel("Frequency (Hz)")
    fig.suptitle("EEG Power Spectral Density", fontsize=16)
    fig.tight_layout()

    fig.savefig(output_path, dpi=300)
    plt.close(fig)


def validate_edf(path: Path, metadata: dict):
    file_size = path.stat().st_size

    expected_header = 256 + 256 * metadata["number_of_signals"]

    if metadata["header_bytes"] != expected_header:
        raise ValueError(
            f"Unexpected header size: "
            f"{metadata['header_bytes']} "
            f"(expected {expected_header})"
        )

    samples_in_records = sum(
        metadata["samples_per_record"]
    )

    expected_size = (
        metadata["header_bytes"]
        + metadata["number_of_records"]
        * samples_in_records
        * 2
    )

    if file_size != expected_size:
        raise ValueError(
            f"File size mismatch: {file_size} bytes; "
            f"expected {expected_size} bytes."
        )


def main():
    parser = argparse.ArgumentParser(
        description="Analyze an EDF EEG recording."
    )

    parser.add_argument(
        "--input",
        type=Path,
        default=Path("data/S14_EEG.edf"),
        help="Path to the EDF file."
    )

    parser.add_argument(
        "--output",
        type=Path,
        default=Path("results"),
        help="Directory for analysis outputs."
    )

    args = parser.parse_args()
    args.output.mkdir(parents=True, exist_ok=True)

    metadata = read_edf_header(args.input)
    validate_edf(args.input, metadata)

    data = read_edf_data(args.input, metadata)
    sampling_rates = calculate_sampling_rates(metadata)

    labels = metadata["labels"]

    summary = summarize_channels(
        data,
        labels,
        sampling_rates
    )

    summary.to_csv(
        args.output / "channel_summary.csv",
        index=False
    )

    plot_raw_signals(
        data,
        labels,
        sampling_rates,
        args.output / "raw_eeg.png"
    )

    plot_psd(
        data,
        labels,
        sampling_rates,
        args.output / "psd.png"
    )

    metadata_output = {
        key: value
        for key, value in metadata.items()
        if key not in {
            "transducers",
            "signal_reserved"
        }
    }

    pd.Series(metadata_output, dtype="object").to_json(
        args.output / "edf_metadata.json",
        force_ascii=False,
        indent=2
    )

    print("Analysis completed successfully.")
    print(f"Input file: {args.input}")
    print(f"Output directory: {args.output}")
    print(f"Channels: {', '.join(labels)}")
    print(
        f"Duration: "
        f"{len(data[0]) / sampling_rates[0]:.2f} seconds"
    )


if __name__ == "__main__":
    main()
